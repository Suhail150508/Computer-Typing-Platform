# cPanel-এ এটিকে কপি করে নাম দিন ".env" এবং নিজের তথ্য বসান
APP_NAME=TypingMoja
APP_ENV=production
# APP_KEY: লোকালে `php artisan key:generate --show` চালিয়ে যা আসবে (base64:...) সেটা বসান
APP_KEY=
APP_DEBUG=false
APP_URL=https://আপনার-ডোমেইন.com

LOG_CHANNEL=single
LOG_LEVEL=error

# cPanel → MySQL Databases থেকে ডাটাবেস + ইউজার বানিয়ে দিন (নামে cpanelUser_ প্রিফিক্স থাকে)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_typingbd
DB_USERNAME=cpuser_typingbd
DB_PASSWORD=

# শেয়ার্ড হোস্টিংয়ে সবচেয়ে নিরাপদ ড্রাইভার
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ইমেইল (পাসওয়ার্ড রিসেটের জন্য জরুরি) — cPanel > Email Accounts-এ noreply@আপনার-ডোমেইন একাউন্ট খুলে নিচে বসান।
# যতক্ষণ MAIL_MAILER=log থাকবে, ইমেইল আসলে যাবে না (শুধু storage/logs/laravel.log-এ লেখা হবে)।
MAIL_MAILER=smtp
MAIL_HOST=mail.typingmoja.site
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@typingmoja.site
MAIL_PASSWORD=ইমেইল-একাউন্টের-পাসওয়ার্ড
MAIL_FROM_ADDRESS=noreply@typingmoja.site
MAIL_FROM_NAME="${APP_NAME}"

# গুগল লগইন (ঐচ্ছিক) — Redirect URI: APP_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
